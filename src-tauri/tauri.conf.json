{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri速记",
  "version": "0.1.0",
  "identifier": "com.dsh.tauri-quicknote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri 速记",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MzU1NTUxODk3NkM3QjEKUldTeHgzYUpVVlUxS0w2aTQ4T1dsZXJJSWxoMmRPY0pjR2paR0krN2hKaFluQmdSVTZwTlNuZ00K",
      "endpoints": [
        "https://github.com/chen1354711/tauri-quicknote/releases/latest/download/latest.json"
      ]
    }
  }
}
